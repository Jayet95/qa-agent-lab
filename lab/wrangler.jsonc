// Cloudflare Workers deployment for the Live Lab.
// Cloudflare settings: Root directory "lab", Build command (empty),
// Deploy command "npx wrangler deploy".
// Secrets (Settings → Variables and secrets, type Secret): GITHUB_TOKEN, LAB_RESULTS_SECRET
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "qa-agent-lab-live",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "LAB_DB",
      // No database_id: `wrangler deploy` finds the "qa-lab" database by name,
      // or creates it on the first deploy (automatic provisioning).
      "database_name": "qa-lab"
    }
  ],
  "vars": {
    "PAYDEMO_URL": "https://paydemo.jayet95.workers.dev",
    "GITHUB_REPO": "Jayet95/qa-agent-lab",
    "DASHBOARD_URL": "https://jayet95.github.io/qa-agent-lab/"
  },
  // Secrets added in the dashboard survive deploys; plain vars come from here.
  "keep_vars": true
}
